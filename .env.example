# Pooled PostgreSQL connection used by the application at runtime.
DATABASE_URL="postgresql://tactlex:tactlex@localhost:5432/tactlex?schema=public"

# Optional direct PostgreSQL connection used by Prisma CLI migrations and seed.
# In production keep this only in the protected deployment environment.
DIRECT_URL=""

# Disposable database whose name must end with _test.
TEST_DATABASE_URL="postgresql://tactlex:tactlex@localhost:5432/tactlex_test?schema=public"

# Random production secret with at least 32 bytes. Used only for digests/metadata,
# never sent to the browser.
SESSION_PEPPER="replace-with-a-random-production-secret"

# Comma-separated exact browser origins accepted for state-changing requests.
ALLOWED_ORIGINS="http://localhost:3000"

# Canonical application URL used for metadata and browser tests.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Human audio uploads are disabled on ephemeral serverless filesystems.
AUDIO_UPLOADS_ENABLED="true"

# Local filesystem is the development default. Future deployments may use s3.
AUDIO_STORAGE_DRIVER="local"
AUDIO_STORAGE_PATH="./storage/audio"

# Temporary one-time input for npm run admin:bootstrap. Remove after use.
ADMIN_EMAIL=""
