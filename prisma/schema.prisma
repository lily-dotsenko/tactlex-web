model XpTransaction {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  amount        Int
  reason        XpReason
  sourceType    String   @map("source_type") @db.VarChar(80)
  sourceId      String   @map("source_id") @db.VarChar(120)
  dedupeKey     String   @unique @map("dedupe_key") @db.VarChar(240)
  policyVersion String   @map("policy_version") @db.VarChar(40)
  metadata      Json?    @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, sourceType, sourceId])
  @@index([userId, createdAt])
  @@map("xp_transactions")
}

model LeaderboardPeriod {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String                @unique @db.VarChar(80)
  type        LeaderboardPeriodType
  startsAt    DateTime?             @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime?             @map("ends_at") @db.Timestamptz(3)
  finalizedAt DateTime?             @map("finalized_at") @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  entries     LeaderboardEntry[]

  @@index([type, startsAt])
  @@map("leaderboard_periods")
}

model LeaderboardEntry {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodId  String            @map("period_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  xp        Int               @default(0)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  period    LeaderboardPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([periodId, userId])
  @@index([periodId, xp(sort: Desc)])
  @@index([userId])
  @@map("leaderboard_entries")
}

model LeagueSeason {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String             @unique @db.VarChar(80)
  startsAt    DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime           @map("ends_at") @db.Timestamptz(3)
  finalizedAt DateTime?          @map("finalized_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  groups      LeagueGroup[]
  memberships LeagueMembership[]

  @@index([startsAt, endsAt])
  @@map("league_seasons")
}

model LeagueGroup {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId    String             @map("season_id") @db.Uuid
  division    LeagueDivision
  groupNumber Int                @map("group_number")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  season      LeagueSeason       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  members     LeagueMembership[]

  @@unique([seasonId, division, groupNumber])
  @@index([seasonId, division])
  @@map("league_groups")
}

model LeagueMembership {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId    String       @map("season_id") @db.Uuid
  groupId     String       @map("group_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  weeklyXp    Int          @default(0) @map("weekly_xp")
  reachedAt   DateTime     @default(now()) @map("reached_at") @db.Timestamptz(3)
  finalizedAt DateTime?    @map("finalized_at") @db.Timestamptz(3)
  season      LeagueSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  group       LeagueGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@index([groupId, weeklyXp(sort: Desc), reachedAt])
  @@index([userId, seasonId])
  @@map("league_memberships")
}

model TermReport {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termId         String       @map("term_id") @db.Uuid
  submittedById  String       @map("submitted_by_id") @db.Uuid
  reason         ReportReason
  details        String?      @db.Text
  status         ReportStatus @default(OPEN)
  resolvedById   String?      @map("resolved_by_id") @db.Uuid
  resolutionNote String?      @map("resolution_note") @db.Text
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  term           Term         @relation(fields: [termId], references: [id], onDelete: Restrict)
  submittedBy    User         @relation("ReportsSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  resolvedBy     User?        @relation("ReportsResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([submittedById, createdAt])
  @@index([termId, status])
  @@map("term_reports")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  targetType  String   @map("target_type") @db.VarChar(80)
  targetId    String?  @map("target_id") @db.VarChar(120)
  requestId   String?  @map("request_id") @db.VarChar(120)
  ipDigest    String?  @map("ip_digest") @db.Char(64)
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}
