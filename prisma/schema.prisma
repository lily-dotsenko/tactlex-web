  displayOrder  Int                 @default(0) @map("display_order")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  progress      UserQuestProgress[]

  @@index([period, isActive, displayOrder])
  @@map("quest_definitions")
}

model UserQuestProgress {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  questId     String              @map("quest_id") @db.Uuid
  periodKey   String              @map("period_key") @db.VarChar(40)
  current     Int                 @default(0)
  status      QuestProgressStatus @default(ACTIVE)
  completedAt DateTime?           @map("completed_at") @db.Timestamptz(3)
  claimedAt   DateTime?           @map("claimed_at") @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest       QuestDefinition     @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, periodKey])
  @@index([userId, status])
  @@map("user_quest_progress")
}

model UserBonus {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        BonusType
  quantity    Int       @default(0)
  activeUntil DateTime? @map("active_until") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("user_bonuses")
}

model PatchDefinition {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String              @unique @db.VarChar(100)
  titleUk       String              @map("title_uk") @db.VarChar(180)
  titleEn       String              @map("title_en") @db.VarChar(180)
  descriptionUk String              @map("description_uk") @db.Text
  descriptionEn String              @map("description_en") @db.Text
  rarity        PatchRarity         @default(COMMON)
  iconKey       String              @map("icon_key") @db.VarChar(80)
  category      String              @db.VarChar(60)
  requirement   Json?               @db.JsonB
  displayOrder  Int                 @default(0) @map("display_order")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  awards        UserPatch[]
  featuredBy    UserFeaturedPatch[]
  nodes         LearningNode[]

  @@index([category, displayOrder])
  @@map("patch_definitions")
}

model UserPatch {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  patchId     String          @map("patch_id") @db.Uuid
  triggerType String          @map("trigger_type") @db.VarChar(80)
  triggerId   String?         @map("trigger_id") @db.VarChar(160)
  awardedAt   DateTime        @default(now()) @map("awarded_at") @db.Timestamptz(3)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patch       PatchDefinition @relation(fields: [patchId], references: [id], onDelete: Cascade)

  @@unique([userId, patchId])
  @@index([patchId, awardedAt])
  @@map("user_patches")
}

model UserFeaturedPatch {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  patchId   String          @map("patch_id") @db.Uuid
  slot      Int             @db.SmallInt
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patch     PatchDefinition @relation(fields: [patchId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
  @@unique([userId, patchId])
  @@index([patchId])
  @@map("user_featured_patches")
}

model CosmeticItem {
