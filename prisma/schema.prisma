}

model UserCosmetic {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  cosmeticId String       @map("cosmetic_id") @db.Uuid
  acquiredAt DateTime     @default(now()) @map("acquired_at") @db.Timestamptz(3)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic   CosmeticItem @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@index([cosmeticId])
  @@map("user_cosmetics")
