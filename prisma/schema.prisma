generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ANONYMIZED
}

enum Locale {
  UK
  EN
}

enum AudienceType {
  MILITARY
  CIVILIAN
  CADET
  VOLUNTEER
  OTHER
  PREFER_NOT_TO_SAY
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ContentOrigin {
  HUMAN
  AI_ASSISTED
  CSV_IMPORT
  SEED_DEMO
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PHRASE
  ABBREVIATION
  PROPER_NOUN
  OTHER
}

enum VariantKind {
  PRIMARY
  SYNONYM
  ABBREVIATION
  INFLECTION
  HYPHEN_VARIANT
}

enum SourceType {
  OFFICIAL_UKRAINIAN
  NATO
  DOD
  DOCTRINE
  DICTIONARY
  MEDICAL
  OTHER
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum ContentReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SUPERSEDED
}

enum AudioProvider {
  LOCAL
  S3_COMPATIBLE
}

enum AudioKind {
  HUMAN_RECORDING
  SYNTHETIC
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Direction {
  EN_TO_UK
  UK_TO_EN
  MIXED
}

enum ExerciseType {
  MULTIPLE_CHOICE
  UA_TO_EN
  EN_TO_UA
  MATCH_PAIRS
  TYPE_ANSWER
  ABBREVIATION
  CONTEXT_SENTENCE
  AUDIO
  PREVIOUSLY_MISSED
}

enum StudySessionKind {
  LESSON
  QUIZ
  CHECKPOINT
  REVIEW
  PRACTICE
}

enum LearningNodeType {
  LESSON
  QUIZ
  FACT
  REWARD
  CHECKPOINT
  PATCH
}

enum PatchRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum QuestPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum QuestMetric {
  XP_EARNED
  CORRECT_ANSWERS
  NODES_COMPLETED
  QUIZZES_COMPLETED
  REVIEWS_COMPLETED
  ACTIVE_DAYS
}

enum QuestProgressStatus {
  ACTIVE
  COMPLETED
  CLAIMED
  EXPIRED
}

enum BonusType {
  DOUBLE_XP_15M
  STREAK_FREEZE
}

enum LeagueDivision {
  BRONZE
  STEEL
  GOLD
  SAPPHIRE
  DIAMOND
}

enum StudySessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  EXPIRED
}

enum StudyStage {
  INTRODUCTION
  PRACTICE
  AFTER_ACTION_REVIEW
}

enum SessionItemStatus {
  PENDING
  ANSWERED
  SKIPPED
}

enum ProgressState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum AchievementMetric {
  LESSONS_COMPLETED
  CONSECUTIVE_CORRECT
  PERFECT_LESSONS
  MASTERED_TERMS
  MASTERED_TERMS_IN_CATEGORY
  CURRENT_STREAK
  PREVIOUSLY_MISSED_CORRECT
  ALL_CATEGORIES_LEVEL
}

enum ComparisonOperator {
  EQUALS
  GREATER_THAN_OR_EQUAL
}

enum AchievementWindow {
  ALL_TIME
  CURRENT_STREAK
  SINGLE_SESSION
}

enum XpReason {
  CORRECT_ANSWER
  SCHEDULED_REVIEW
  FIRST_LESSON_COMPLETION
  PERFECT_LESSON
  ACHIEVEMENT
  FACT_COMPLETION
  QUEST_REWARD
  ADMIN_ADJUSTMENT
}

enum LeaderboardPeriodType {
  WEEKLY
  ALL_TIME
}

enum ReportReason {
  INCORRECT_TRANSLATION
  INCORRECT_DEFINITION
  INCORRECT_AUDIO
  BROKEN_SOURCE
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ImportStatus {
  PENDING
  VALIDATING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

enum ImportRowStatus {
  PENDING
  IMPORTED
  REJECTED
}

model User {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                     @unique @db.Citext
  passwordHash         String                     @map("password_hash") @db.Text
  status               UserStatus                 @default(ACTIVE)
  emailVerifiedAt      DateTime?                  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt          DateTime?                  @map("last_login_at") @db.Timestamptz(3)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile              UserProfile?
  userRoles            UserRole[]                 @relation("UserRoles")
  rolesAssigned        UserRole[]                 @relation("RolesAssignedBy")
  sessions             AuthSession[]
  verificationTokens   VerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  createdTerms         Term[]                     @relation("TermsCreatedBy")
  updatedTerms         Term[]                     @relation("TermsUpdatedBy")
  approvedTerms        Term[]                     @relation("TermsApprovedBy")
  publishedTerms       Term[]                     @relation("TermsPublishedBy")
  checkedTermSources   TermSource[]               @relation("TermSourcesCheckedBy")
  requestedReviews     ContentReview[]            @relation("ReviewsRequestedBy")
  assignedReviews      ContentReview[]            @relation("ReviewsAssignedTo")
  decidedReviews       ContentReview[]            @relation("ReviewsDecidedBy")
  revisions            ContentRevision[]
  audioUploads         AudioAsset[]
  createdLessons       Lesson[]                   @relation("LessonsCreatedBy")
  updatedLessons       Lesson[]                   @relation("LessonsUpdatedBy")
  studySessions        StudySession[]
  sessionAnswers       SessionAnswer[]
  termProgress         UserTermProgress[]
  reviewLogs           ReviewLog[]
  dailyActivities      UserDailyActivity[]
  lessonProgress       UserLessonProgress[]
  achievements         UserAchievement[]
  xpTransactions       XpTransaction[]
  leaderboardEntries   LeaderboardEntry[]
  submittedReports     TermReport[]               @relation("ReportsSubmittedBy")
  resolvedReports      TermReport[]               @relation("ReportsResolvedBy")
  imports              ContentImport[]
  idempotencyRequests  IdempotencyRequest[]
  auditLogs            AuditLog[]
  learningNodeProgress UserLearningNodeProgress[]
  wallet               UserWallet?
  coinTransactions     CoinTransaction[]
  questProgress        UserQuestProgress[]
  bonuses              UserBonus[]
  patches              UserPatch[]
  featuredPatches      UserFeaturedPatch[]
  cosmetics            UserCosmetic[]
  leagueMemberships    LeagueMembership[]

  @@map("users")
}

model UserProfile {
  userId             String         @id @map("user_id") @db.Uuid
  nickname           String         @unique @db.Citext
  audienceType       AudienceType?  @map("audience_type")
  preferredLocale    Locale         @default(UK) @map("preferred_locale")
  timezone           String         @default("Europe/Kyiv") @db.VarChar(64)
  dailyGoalXp        Int            @default(20) @map("daily_goal_xp")
  leaderboardVisible Boolean        @default(false) @map("leaderboard_visible")
  avatarKey          String         @default("atlas-olive") @map("avatar_key") @db.VarChar(40)
  avatarConfig       Json?          @map("avatar_config") @db.JsonB
  totalXp            Int            @default(0) @map("total_xp")
  level              Int            @default(1)
  currentStreak      Int            @default(0) @map("current_streak")
  longestStreak      Int            @default(0) @map("longest_streak")
  leagueDivision     LeagueDivision @default(BRONZE) @map("league_division")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(80)
  nameUk      String           @map("name_uk") @db.VarChar(120)
  nameEn      String           @map("name_en") @db.VarChar(120)
  isSystem    Boolean          @default(true) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String           @unique @db.VarChar(120)
  nameUk        String           @map("name_uk") @db.VarChar(160)
  nameEn        String           @map("name_en") @db.VarChar(160)
  descriptionUk String?          @map("description_uk") @db.Text
  descriptionEn String?          @map("description_en") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles         RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedById String?   @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  user         User      @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?     @relation("RolesAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash    String    @map("csrf_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  idleExpiresAt    DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason String?   @map("revocation_reason") @db.VarChar(120)
  ipDigest         String?   @map("ip_digest") @db.Char(64)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model VerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model RateLimitBucket {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action          String   @db.VarChar(80)
  bucketKey       String   @map("bucket_key") @db.Char(64)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  windowEndsAt    DateTime @map("window_ends_at") @db.Timestamptz(3)
  count           Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([action, bucketKey, windowStartedAt])
  @@index([action, bucketKey])
  @@index([windowEndsAt])
  @@map("rate_limit_buckets")
}

model IdempotencyRequest {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?           @map("user_id") @db.Uuid
  principalKey   String            @map("principal_key") @db.Char(64)
  scope          String            @db.VarChar(120)
  key            String            @db.VarChar(120)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body") @db.JsonB
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([principalKey, scope, key])
  @@index([expiresAt])
  @@map("idempotency_requests")
}

model Category {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String            @unique @db.VarChar(80)
  nameUk           String            @map("name_uk") @db.VarChar(160)
  nameEn           String            @map("name_en") @db.VarChar(160)
  descriptionUk    String?           @map("description_uk") @db.Text
  descriptionEn    String?           @map("description_en") @db.Text
  targetTermCount  Int               @map("target_term_count")
  displayOrder     Int               @default(0) @map("display_order")
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  terms            TermCategory[]
  contextDefinitions TermContextDefinition[]
  lessons          Lesson[]
  achievementRules AchievementRule[]
  learningNodes    LearningNode[]

  @@index([archivedAt, displayOrder])
  @@map("categories")
}

model Term {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String             @unique @db.VarChar(120)
  partOfSpeech     PartOfSpeech       @map("part_of_speech")
  difficulty       Int                @db.SmallInt
  status           ContentStatus      @default(DRAFT)
  origin           ContentOrigin      @default(HUMAN)
  isDemo           Boolean            @default(false) @map("is_demo")
  isBeta           Boolean            @default(false) @map("is_beta")
  currentRevision  Int                @default(1) @map("current_revision")
  createdById      String             @map("created_by_id") @db.Uuid
  updatedById      String             @map("updated_by_id") @db.Uuid
  approvedById     String?            @map("approved_by_id") @db.Uuid
  publishedById    String?            @map("published_by_id") @db.Uuid
  approvedAt       DateTime?          @map("approved_at") @db.Timestamptz(3)
  publishedAt      DateTime?          @map("published_at") @db.Timestamptz(3)
  archivedAt       DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy        User               @relation("TermsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy        User               @relation("TermsUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  approvedBy       User?              @relation("TermsApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  publishedBy      User?              @relation("TermsPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  categories       TermCategory[]
  variants         TermVariant[]
  definitions      TermDefinition[]
  contextDefinitions TermContextDefinition[]
  sources          TermSource[]
  reviews          ContentReview[]
  revisions        ContentRevision[]
  audioAssets      AudioAsset[]
  distractors      TermDistractor[]   @relation("DistractorForTerm")
  usedAsDistractor TermDistractor[]   @relation("DistractorTerm")
  lessonTerms      LessonTerm[]
  sessionItems     StudySessionItem[]
  sessionAnswers   SessionAnswer[]
  userProgress     UserTermProgress[]
  reviewLogs       ReviewLog[]
  reports          TermReport[]
  importRows       ContentImportRow[]

  @@index([status, publishedAt])
  @@index([createdById, createdAt])
  @@map("terms")
}

model TermCategory {
  termId     String   @map("term_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  term       Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([termId, categoryId])
  @@index([categoryId, isPrimary])
  @@map("term_categories")
}

model TermVariant {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termId           String             @map("term_id") @db.Uuid
  locale           Locale
  kind             VariantKind
  value            String             @db.VarChar(200)
  normalizedValue  String             @map("normalized_value") @db.VarChar(200)
  isPrimary        Boolean            @default(false) @map("is_primary")
  isAcceptedAnswer Boolean            @default(true) @map("is_accepted_answer")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  term             Term               @relation(fields: [termId], references: [id], onDelete: Cascade)
  acceptedAnswers  SessionAnswer[]
  promptItems      StudySessionItem[]

  @@unique([termId, locale, normalizedValue])
  @@index([locale, normalizedValue])
  @@map("term_variants")
}

model TermDefinition {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termId          String   @map("term_id") @db.Uuid
  locale          Locale
  shortDefinition String?  @map("short_definition") @db.Text
  example         String?  @db.Text
  contextNote     String?  @map("context_note") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  term            Term     @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([termId, locale])
  @@map("term_definitions")
}

model TermContextDefinition {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termId          String   @map("term_id") @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  locale          Locale
  shortDefinition String?  @map("short_definition") @db.Text
  example         String?  @db.Text
  contextNote     String?  @map("context_note") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  term            Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([termId, categoryId, locale])
  @@index([categoryId, locale])
  @@map("term_context_definitions")
}

model Source {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exactUrl   String       @unique @map("exact_url") @db.Text
  title      String       @db.VarChar(300)
  publisher  String?      @db.VarChar(200)
  sourceType SourceType   @map("source_type")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  terms      TermSource[]

  @@map("sources")
}

model TermSource {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termId             String             @map("term_id") @db.Uuid
  sourceId           String             @map("source_id") @db.Uuid
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  checkedAt          DateTime?          @map("checked_at") @db.Timestamptz(3)
  checkedById        String?            @map("checked_by_id") @db.Uuid
  citationNote       String?            @map("citation_note") @db.Text
  isPrimary          Boolean            @default(false) @map("is_primary")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  term               Term               @relation(fields: [termId], references: [id], onDelete: Cascade)
  source             Source             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  checkedBy          User?              @relation("TermSourcesCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)

  @@unique([termId, sourceId])
  @@index([sourceId])
  @@index([termId, verificationStatus])
  @@map("term_sources")
}

model ContentReview {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termId         String              @map("term_id") @db.Uuid
  revisionNumber Int                 @map("revision_number")
  status         ContentReviewStatus @default(PENDING)
  requestedById  String              @map("requested_by_id") @db.Uuid
  assignedToId   String?             @map("assigned_to_id") @db.Uuid
  decidedById    String?             @map("decided_by_id") @db.Uuid
  note           String?             @db.Text
  submittedAt    DateTime            @default(now()) @map("submitted_at") @db.Timestamptz(3)
  decidedAt      DateTime?           @map("decided_at") @db.Timestamptz(3)
  term           Term                @relation(fields: [termId], references: [id], onDelete: Restrict)
  requestedBy    User                @relation("ReviewsRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  assignedTo     User?               @relation("ReviewsAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  decidedBy      User?               @relation("ReviewsDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([termId, status])
  @@index([assignedToId, status])
  @@map("content_reviews")
}

model ContentRevision {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termId         String   @map("term_id") @db.Uuid
  revisionNumber Int      @map("revision_number")
  authorUserId   String   @map("author_user_id") @db.Uuid
  checksum       String   @db.Char(64)
  snapshot       Json     @db.JsonB
  changeNote     String?  @map("change_note") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
